# Salin file ini menjadi .env lalu isi nilainya sesuai akunmu.
# Jangan pernah mengunggah file .env ke GitHub.

# --- Google Workspace ---
SHEET_ID=
CALENDAR_ID=
TUGAS_URL=
TUGAS_KUNCI=
CATATAN_DOC_ID=
# Opsional: isi JSON service account langsung jika tidak memakai file kunci-google.json
# GOOGLE_KEY_JSON=

# --- Keamanan & Whitelist WhatsApp (Baileys) ---
# Nomor WhatsApp utama yang diizinkan memakai bot & menerima pengingat proaktif.
# Boleh lebih dari satu nomor dipisahkan koma, contoh: 6281234567890,6289876543210
NOMOR_KAMU=628xxxxxxxxxx
# Opsional: JID grup yang diizinkan memakai bot (dipisahkan koma), contoh: 120363xxxx@g.us
WHITELIST_GRUP=
# Interval pengecekan pengingat berkala dalam detik (bawaan: 60)
INTERVAL_PENGINGAT_DETIK=60
# URL API Python yang dihubungi bot-baileys
API_URL=http://127.0.0.1:8000
# Set true HANYA jika ingin mengizinkan semua pengirim saat NOMOR_KAMU kosong (tidak disarankan)
MODE_TERBUKA=false

# --- Input Cerdas (Scan Struk Foto, Voice Note, Bahasa Natural / LLM Fallback) ---
# Rekomendasi: isi GEMINI_API_KEY (satu kunci untuk gambar, audio, dan teks).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opsional alternatif jika memakai OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set false untuk mematikan panggilan AI eksternal (parser bahasa natural lokal tetap aktif)
AI_AKTIF=true

# --- Produktivitas ---
# Sinkronkan /deadline ke Google Calendar secara otomatis (true/false)
DEADLINE_KE_KALENDER=true

# --- Server API Lokal ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Sinkronisasi Morgana Companion (Laptop <-> Bot WA Termux) ---
# Isi token rahasia yang sama di Settings -> WhatsApp Bot Sync pada Morgana Companion.
MORGANA_SYNC_TOKEN=
MORGANA_PENGINGAT_AKTIF=true
